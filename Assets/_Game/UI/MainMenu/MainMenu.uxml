<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainMenu.uss" />

    <ui:VisualElement name="main-menu-root" class="menu-root">

        <!-- Optional Full-Screen Background (Auto-hides if left None so Camera/Scene BG shows) -->
        <ui:VisualElement name="menu-bg" class="menu-bg" style="display: none;" picking-mode="Ignore" />

        <!-- Center Column Positioned Below the Book Emblem -->
        <ui:VisualElement name="menu-center-column" class="menu-center-column" picking-mode="Ignore">

            <!-- Optional Logo Image (Auto-hides if left None when baked into scene BG) -->
            <ui:VisualElement name="menu-logo" class="menu-logo" style="display: none;" picking-mode="Ignore" />

            <!-- Paper-Cutout Button Stack -->
            <ui:VisualElement name="menu-button-stack" class="menu-button-stack">

                <!-- CONTINUE -->
                <ui:VisualElement name="rim-continue" class="menu-cutout-rim">
                    <ui:Button name="btn-menu-continue" class="menu-btn menu-btn--primary">
                        <ui:VisualElement class="menu-btn__bookmark" picking-mode="Ignore" />
                        <ui:Label text="CONTINUE" class="menu-btn__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- NEW GAME -->
                <ui:VisualElement name="rim-newgame" class="menu-cutout-rim">
                    <ui:Button name="btn-menu-newgame" class="menu-btn">
                        <ui:VisualElement class="menu-btn__bookmark" picking-mode="Ignore" />
                        <ui:Label text="NEW GAME" class="menu-btn__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- LOAD GAME -->
                <ui:VisualElement name="rim-load" class="menu-cutout-rim">
                    <ui:Button name="btn-menu-load" class="menu-btn">
                        <ui:VisualElement class="menu-btn__bookmark" picking-mode="Ignore" />
                        <ui:Label text="LOAD" class="menu-btn__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- SETTINGS -->
                <ui:VisualElement name="rim-settings" class="menu-cutout-rim">
                    <ui:Button name="btn-menu-settings" class="menu-btn">
                        <ui:VisualElement class="menu-btn__bookmark" picking-mode="Ignore" />
                        <ui:Label text="SETTINGS" class="menu-btn__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- EXIT -->
                <ui:VisualElement name="rim-exit" class="menu-cutout-rim">
                    <ui:Button name="btn-menu-exit" class="menu-btn menu-btn--exit">
                        <ui:VisualElement class="menu-btn__bookmark" picking-mode="Ignore" />
                        <ui:Label text="EXIT" class="menu-btn__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Dimmed Backdrop for Load & Settings Modals -->
        <ui:VisualElement name="menu-modal-overlay" class="modal-overlay" style="display: none;">

            <!-- Load Game Modal -->
            <ui:VisualElement name="menu-load-panel" class="modal-cutout-rim saveload-rim" style="display: none;">
                <ui:VisualElement class="parchment-modal saveload-modal">
                    <ui:VisualElement class="modal-arch-accent" />
                    <ui:Label text="LOAD MEMORY" class="modal-title" />
                    <ui:ScrollView name="menu-load-list" class="saveload-list" />
                    <ui:Button name="btn-menu-load-back" text="BACK" class="modal-action-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Settings Modal (Reuses VNSettingsView) -->
            <ui:VisualElement name="menu-settings-panel" class="modal-cutout-rim settings-rim" style="display: none;">
                <ui:VisualElement name="menu-settings-content" class="parchment-modal settings-modal" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Scene Transition Fade Curtain -->
        <ui:VisualElement name="menu-fade-curtain" class="fade-curtain" style="opacity: 0; display: none;" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>