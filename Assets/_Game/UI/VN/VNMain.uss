:root {
    --color-bg-panel: rgba(14, 17, 24, 0.90);
    --color-bg-nameplate: rgba(28, 34, 48, 0.98);
    --color-bg-choice: rgba(20, 24, 34, 0.94);
    --color-bg-choice-hover: rgba(48, 62, 92, 0.98);
    --color-border: rgba(255, 255, 255, 0.16);
    --color-accent: rgb(118, 169, 250);
    --color-text-primary: rgb(243, 244, 246);
    --color-text-muted: rgb(156, 163, 175);
    --color-dim-tint: rgb(135, 135, 145);
}

.vn-root {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.fullscreen-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* --- LAYER 1 & 3: Backgrounds & Event CGs --- */
.bg-slot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-size: cover;
    background-position: center center;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

#layer-cg {
    display: none;
    opacity: 0;
}

/* --- LAYER 2: Character Stage --- */
.stage-layer {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.character-slot {
    position: absolute;
    bottom: 0;
    width: 680px;
    height: 92%;
    background-size: contain;
    background-position: center bottom;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.18s;
}

.character-slot--dimmed {
    -unity-background-image-tint-color: var(--color-dim-tint);
}

/* --- LAYER 5: Dialogue HUD --- */
.hud-layer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 36px;
    align-items: center;
}

.dialogue-box {
    width: 78%;
    max-width: 1480px;
    min-height: 230px;
    padding: 42px 48px 34px 48px;
    background-color: var(--color-bg-panel);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: 10px;
    translate: 0 0;
    opacity: 1;
}

.nameplate {
    position: absolute;
    top: -22px;
    left: 36px;
    padding: 6px 22px;
    background-color: var(--color-bg-nameplate);
    border-color: var(--color-accent);
    border-width: 1px;
    border-radius: 6px;
}

.speaker-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-accent);
    letter-spacing: 1px;
}

.dialogue-label {
    font-size: 26px;
    line-height: 38px;
    color: var(--color-text-primary);
    white-space: normal;
    -unity-text-align: upper-left;
}

.continue-indicator {
    position: absolute;
    right: 28px;
    bottom: 22px;
    width: 14px;
    height: 14px;
    background-color: var(--color-accent);
    rotate: 45deg;
    opacity: 0;
}

/* Quick Bar */
/* --- LAYER 5A: Top-Right Icon Bar --- */
.top-bar {
    position: absolute;
    top: 26px;
    right: 32px;
    flex-direction: row;
    align-items: center;
}

.icon-btn {
    width: 48px;
    height: 48px;
    margin-left: 12px;
    padding: 10px;
    justify-content: center;
    align-items: center;
    background-color: var(--color-bg-panel);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: 24px;
    scale: 1 1;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.14s;
}

.icon-btn:hover {
    border-color: var(--color-accent);
    background-color: rgba(28, 34, 48, 0.96);
    scale: 1.06 1.06;
}

.icon-btn--active,
.icon-btn--active:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
}

.icon-btn__glyph {
    width: 24px;
    height: 24px;
    background-size: contain;
    background-position: center center;
    rotate: 0deg;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.icon-btn--active .icon-btn__glyph {
    -unity-background-image-tint-color: rgb(14, 17, 24);
}

/* --- LAYER 7: Pause Menu --- */
.modal-overlay {
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(6, 8, 12, 0.82);
}

.pause-panel {
    width: 380px;
    padding: 36px 32px;
    align-items: stretch;
    background-color: var(--color-bg-panel);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: 12px;
}

.pause-title {
    margin-bottom: 24px;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
}

.pause-btn {
    margin-bottom: 12px;
    padding: 14px 20px;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--color-text-primary);
    background-color: var(--color-bg-choice);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: 6px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.pause-btn:hover {
    background-color: var(--color-bg-choice-hover);
    border-color: var(--color-accent);
}

.pause-btn--danger:hover {
    border-color: rgb(248, 113, 113);
    background-color: rgba(127, 29, 29, 0.55);
}

/* --- LAYER 6: Branching Choices --- */
.choice-overlay {
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(6, 8, 12, 0.45);
}

.choice-list {
    width: 52%;
    max-width: 920px;
    align-items: stretch;
}

.choice-btn {
    margin-bottom: 14px;
    padding: 18px 28px;
    font-size: 23px;
    color: var(--color-text-primary);
    background-color: var(--color-bg-choice);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.choice-btn:hover,
.choice-btn:focus {
    background-color: var(--color-bg-choice-hover);
    border-color: var(--color-accent);
    scale: 1.015 1.015;
}

.choice-btn--visited,
.choice-btn--visited:hover,
.choice-btn--visited:focus {
    color: rgba(156, 163, 175, 0.45);
    background-color: rgba(14, 17, 24, 0.55);
    border-color: rgba(255, 255, 255, 0.07);
    scale: 1 1;
}

/* --- LAYER 7: Modals (Backlog, Save/Load, Config) --- */
.modal-overlay {
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(6, 8, 12, 0.82);
}